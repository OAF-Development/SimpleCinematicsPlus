FrameWidgetClass SCPlusOverlayRoot {
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  CanvasWidgetClass SCPlusOverlayCanvas {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
  }
  TextWidgetClass SCPlusOverlayText {
   visible 0
   ignorepointer 1
   color 1 1 1 0.9
   position 0 0
   size 1 160
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 1
   text ""
   font "gui/fonts/Metron"
   "exact text" 1
   "exact text size" 120
   "text halign" center
   "text valign" center
  }
 }
}
