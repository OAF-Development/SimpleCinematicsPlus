PanelWidgetClass DropdownPanel {
 clipchildren 1
 ignorepointer 1
 size 0.97 24
 halign left_ref
 valign top_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 1
 scaled 1
 priority 1
 draggable 0
 scriptclass ""
 style blank
 {
  PanelWidgetClass DropdownOutline {
   visible 1
   clipchildren 1
   ignorepointer 1
   color 0.7059 0.7059 0.7059 0.9961
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style Outline_1px
   {
    ButtonWidgetClass Button {
     clipchildren 1
     color 0.1373 0.1373 0.1373 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     scaled 1
     scriptclass "ViewBinding"
     style Default
     text ""
     text_proportion 0.68
     text_halign left
     font "gui/fonts/Metron"
     {
      ImageWidgetClass DropdownArrow {
       visible 1
       clipchildren 0
       ignorepointer 1
       position 6 0
       size 12 12
       halign right_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       image0 "set:ccgui_enforce image:CrScrollV"
       mode blend
       "src alpha" 1
       "stretch mode" stretch_w_h
       "flip v" 1
       filter 1
      }
     }
     {
      ScriptParamsClass {
       Binding_Name "Value"
       Selected_Item "Caption"
       Two_Way_Binding 1
       Relay_Command "ButtonExecute"
      }
     }
    }
   }
  }
 }
}
